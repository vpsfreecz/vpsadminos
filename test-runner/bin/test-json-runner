#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'test-runner'

if ARGV.length != 2
  warn "usage: #{$0} <test-json> <state-dir>"
  exit 2
end

json_path = File.expand_path(ARGV[0])
state_dir = File.expand_path(ARGV[1])
test_path = ENV.fetch('TEST_PATH', 'direct-json')
timeout = Integer(ENV.fetch('TEST_TIMEOUT', '7200'))
jobs = Integer(ENV.fetch('TEST_JOBS', '1'))
recreate_disks = ENV.fetch('TEST_RECREATE_DISKS', '0') == '1'
destructive = ENV.fetch('TEST_DESTRUCTIVE', '1') == '1'
system = ENV.fetch('TEST_SYSTEM', 'x86_64-linux')
data = JSON.parse(File.read(json_path))

test = TestRunner::Test.new(
  path: test_path,
  type: nil,
  template: nil,
  template_args: nil,
  test_args: {},
  name: data.fetch('name'),
  description: data.fetch('description'),
  attempts: data.fetch('attempts'),
  expect_failure: data.fetch('expectFailure'),
  test_script_jobs: data.fetch('testScriptJobs', {}),
  tags: data.fetch('tags'),
  labels: data.fetch('labels'),
  test_scripts: data.fetch('testScripts')
)

class << TestRunner::TestConfig
  attr_accessor :direct_json_path

  def build(test, config_path:, **_opts)
    FileUtils.mkdir_p(File.dirname(config_path))
    FileUtils.cp(direct_json_path, config_path)

    tc = allocate
    tc.instance_variable_set(:@test, test)
    tc.instance_variable_set(:@config_path, config_path)
    tc.instance_variable_set(:@config, JSON.parse(File.read(config_path)))
    tc
  end
end

TestRunner::TestConfig.direct_json_path = json_path

executor = TestRunner::Executor.new(
  test.test_scripts.values,
  state_dir: state_dir,
  jobs: jobs,
  default_timeout: timeout,
  stop_on_failure: false,
  destructive: destructive,
  recreate_disks: recreate_disks,
  system: system,
  test_config_path: nil
)

results = executor.run
exit(results.any?(&:unexpected_result?) ? 1 : 0)
