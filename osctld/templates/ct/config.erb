### Generated by osctld
# Distribution config
<% OsCtld::Lxc::dist_lxc_configs(distribution, version).each do |cfg| -%>
lxc.include = <%= cfg %>
<% end -%>
<% if ct.nesting -%>
lxc.include = <%= File.join(Lxc::CONFIGS, 'nesting.conf') %>
<% end -%>

lxc.log.syslog = local4
<% if ct.map_mode == 'native' -%>
lxc.rootfs.path = dir:<%= ct.mounts.shared_dir.host_path_for(ct.get_run_conf.rootfs) %>
<% elsif ct.map_mode == 'zfs' -%>
lxc.rootfs.path = dir:<%= ct.get_run_conf.rootfs %>
<% end -%>
lxc.arch = <%= ct.arch %>
lxc.uts.name = <%= ct.hostname || ct.id %>

# UID/GID mapping
<% ct.user.uid_map.each do |entry| -%>
lxc.idmap = u <%= entry.ns_id %> <%= entry.host_id %> <%= entry.id_count %>
<% end -%>
<% ct.user.gid_map.each do |entry| -%>
lxc.idmap = g <%= entry.ns_id %> <%= entry.host_id %> <%= entry.id_count %>
<% end -%>

# Security
lxc.seccomp.profile = <%= ct.seccomp_profile %>
<% if AppArmor.enabled? -%>
<% if AppArmor.lsm_namespace_supported? -%>
# AppArmor LSM namespace
lxc.namespace.clone.lsm = apparmor
lxc.namespace.clone.lsm.name = <%= ct.apparmor.namespace %>
<% end -%>
lxc.apparmor.profile = <%= ct.apparmor.lxc_profile_name %>
<% else -%>
lxc.apparmor.profile = unconfined
<% end -%>
lxc.autodev = 1

# Tracing namespace
<% if File.exist?('/proc/self/ns/tracing') -%>
lxc.namespace.clone.tracing = 1
<% else -%>
# Disabled: tracing namespace support not present
<% end -%>

# Time namespace
<% if OsCtld::Daemon.get.config.enable_time_namespace? -%>
lxc.time.offset.boot = -<%= Process.clock_gettime(Process::CLOCK_BOOTTIME, :second) %>s
lxc.time.offset.monotonic = -<%= Process.clock_gettime(Process::CLOCK_MONOTONIC, :second) %>s
<% else -%>
# Disabled in configuration
<% end -%>

# Init
lxc.init.cmd = <%= ct.format_exec_init_cmd %>

# Internal hooks into osctld
lxc.hook.version = 1
lxc.hook.pre-start = <%= OsCtld::hook_run('ct-pre-start', ct.pool) %>
lxc.hook.pre-mount = <%= OsCtld::hook_run('ct-pre-mount', ct.pool) %>
lxc.hook.mount = <%= OsCtld::hook_run('ct-post-mount', ct.pool) %>
lxc.hook.autodev = <%= OsCtld::hook_run('ct-autodev', ct.pool) %>
lxc.hook.start-host = <%= OsCtld::hook_run('ct-on-start', ct.pool) %>
lxc.hook.post-stop = <%= OsCtld::hook_run('ct-post-stop', ct.pool) %>

# Network interfaces
<% netifs.each_with_index do |netif, i| -%>
<%= ErbTemplate.render("ct/net_interface/#{netif.type}", netif.render_opts) %>
<% end -%>

# Cgroup parameters
<% cgparams.each_usable do |p| -%>
<% next unless %w(cpu cpuset).include?(p.subsystem) -%>
<% p.value.each do |v| -%>
lxc.cgroup<%= CGroup.v2? ? '2' : '' %>.<%= p.name %> = <%= v %>
<% end -%>
<% end -%>

# Process limits
<% prlimits.each do |name, limit| -%>
lxc.prlimit.<%= name %> = <%= limit.soft %>:<%= limit.hard %>
<% end -%>

# Mounts
<% mounts.each do |m| -%>
<% if ct.map_mode == 'native' && m.map_ids -%>
lxc.mount.entry = <%= ct.mounts.shared_dir.host_path_for(m.fs) %> <%= m.lxc_mountpoint %> <%= m.type %> <%= m.opts %>
<% else -%>
lxc.mount.entry = <%= m.fs %> <%= m.lxc_mountpoint %> <%= m.type %> <%= m.opts %>
<% end -%>
<% end -%>

# Appended user raw config
<%= raw %>
