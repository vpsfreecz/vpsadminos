  ruby -rjson - "$EVENTS_TSV" "$LANE_RESULTS_TSV" "$SUMMARY_JSON" <<'RUBY'
events_tsv, lane_results_tsv, summary_json = ARGV
events = []
lane_results = []

def first_json_object(text)
  start = text.index('{')
  return text if start.nil?

  depth = 0
  in_string = false
  escaped = false

  text.chars.each_with_index do |ch, index|
    next if index < start

    if in_string
      if escaped
        escaped = false
      elsif ch == '\\'
        escaped = true
      elsif ch == '"'
        in_string = false
      end
      next
    end

    case ch
    when '"'
      in_string = true
    when '{'
      depth += 1
    when '}'
      depth -= 1
      return text[start..index] if depth == 0
    end
  end

  text[start..]
end

File.readlines(events_tsv, chomp: true).each do |line|
  lane, unit, log, event, payload = line.split("\t", 5)
  next if payload.nil?

  begin
    data = JSON.parse(first_json_object(payload))
  rescue JSON::ParserError
    next
  end

  events << {
    'lane' => lane,
    'unit' => unit,
    'log' => log,
    'event' => event,
    'data' => data,
  }
end

File.readlines(lane_results_tsv, chomp: true).each do |line|
  lane, unit, result_file, result, log, diagnostic_line = line.split("\t", 6)
