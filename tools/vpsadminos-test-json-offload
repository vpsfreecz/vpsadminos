#!/usr/bin/env bash
set -euo pipefail

script_path=$(readlink -f "$0")
repo_root=$(readlink -f "$(dirname "$script_path")/..")
state_base=${XDG_STATE_HOME:-$HOME/.local/state}/vpsadminos

usage() {
  cat <<'EOF'
Usage: tools/vpsadminos-test-json-offload <command> [test-path]

Build a focused vpsAdminOS test JSON locally, copy the JSON and test-runner
closure to a remote KVM host, run N independent systemd lanes there, and
collect machine-readable result rows from the test-runner logs.

Commands:
  build-json   Build the focused test JSON and package the direct JSON runner
  copy         Copy the JSON and runner closures to the offload host
  launch       Launch remote systemd lanes
  status       Show remote lane systemd states
  watch        Show lane progress/load, wait for completion, then collect
  wait         Wait until all launched lane units have stopped
  collect      Collect proxy-exec result rows and write a local summary
  summary      Print a compact classification table from collected artifacts
  classify     Alias for summary
  run          build-json, copy, launch, wait, and collect
  run-watch    build-json, copy, launch, watch, and collect

Environment:
  VPSADMINOS_TEST_PATH                 Test path, e.g. kernel/sched-proxy-exec-lock-badneighbor
  VPSADMINOS_TEST_RUN_ID               Stable run id. Defaults to a timestamped id
  VPSADMINOS_TEST_OFFLOAD_STATE_DIR    Local state dir for manifest/results
  VPSADMINOS_TEST_OFFLOAD_HOST         SSH host, e.g. root@172.16.9.33
  VPSADMINOS_TEST_OFFLOAD_SSH_KEY      Optional SSH key
  VPSADMINOS_TEST_OFFLOAD_KNOWN_HOSTS  Optional known_hosts file
  VPSADMINOS_TEST_OFFLOAD_LANES        Number of remote lanes, default: 4
  VPSADMINOS_TEST_OFFLOAD_TIMEOUT      Wait timeout in seconds, default: 10800
  VPSADMINOS_TEST_OFFLOAD_SSH_CONNECT_TIMEOUT
                                       SSH connect timeout in seconds,
                                       default: 15
  VPSADMINOS_TEST_OFFLOAD_SSH_SERVER_ALIVE_INTERVAL
                                       SSH keepalive interval in seconds,
                                       default: 30
  VPSADMINOS_TEST_OFFLOAD_SSH_SERVER_ALIVE_COUNT_MAX
                                       Missed keepalives before SSH exits,
                                       default: 4
  VPSADMINOS_TEST_OFFLOAD_SSH_COMMAND_TIMEOUT
                                       Local timeout for SSH launch/collect/stop
                                       commands, default: 120; 0 disables
  VPSADMINOS_TEST_OFFLOAD_SSH_POLL_TIMEOUT
                                       Local timeout for SSH status/progress
                                       polling commands, default: 30; 0 disables
  VPSADMINOS_TEST_OFFLOAD_SSH_DIAG_TIMEOUT
                                       Local timeout for stale diagnostic
                                       capture, default: 240; 0 disables
  VPSADMINOS_TEST_OFFLOAD_WATCH_INTERVAL
                                       Watch refresh interval in seconds,
                                       default: wait interval
  VPSADMINOS_TEST_OFFLOAD_STALE_TIMEOUT
                                       Stop this run's active lane unit after
                                       this many seconds with no new
                                       proxy-exec progress/result/summary row
                                       and no lane log activity.
                                       Defaults to 900
                                       for lock-badneighbor, otherwise 0
                                       (disabled)
  VPSADMINOS_TEST_OFFLOAD_STALE_STOP_GRACE
                                       Seconds to wait for a stale unit to
                                       stop before SIGKILL, default: 30
  VPSADMINOS_TEST_OFFLOAD_STALE_DIAG_LINES
                                       Lines of journal/test log captured
                                       before stopping a stale lane, default:
                                       400
  VPSADMINOS_TEST_OFFLOAD_REMOTE_BASE  Remote state base, default: /r/vpsadminos-test-json
  VPSADMINOS_TEST_OFFLOAD_REMOTE_RUN_ID
                                       Optional remote state id. Defaults to a
                                       short generated id to keep QEMU UNIX
                                       socket paths below their length limit
  VPSADMINOS_TEST_OFFLOAD_REQUIRE_EVENTS
                                       Require at least one proxy-exec result
                                       row during collect, default: 1
  VPSADMINOS_TEST_OFFLOAD_FORWARD_ENV_PREFIXES
                                       Space/comma separated prefixes forwarded
                                       to remote lanes, default: VPSADMINOS_PROXY_
  VPSADMINOS_TEST_OFFLOAD_FORWARD_ENV_NAMES
                                       Space/comma separated exact env names to
                                       forward to remote lanes
  VPSADMINOS_LOCAL_KERNEL_STAGE        Optional staged kernel consumed by Nix eval
  VPSADMINOS_LOCAL_ZFS_STAGE           Optional staged ZFS consumed by Nix eval

The command does not invoke qemu directly. It runs vpsAdminOS test-runner JSON
through the packaged test-json-runner on the remote host.
EOF
}

log() {
  printf '[vpsadminos-test-json-offload] %s\n' "$*" >&2
}

die() {
  log "ERROR: $*"
  exit 1
}

resolve_cmd() {
  local var=$1
  local name=$2
  local value=${!var:-}

  if [[ -n "$value" ]]; then
    [[ -x "$value" ]] || die "$var is set to non-executable path: $value"
    printf '%s\n' "$value"
  elif command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
  elif [[ -x "/root/.nix-profile/bin/$name" ]]; then
    printf '/root/.nix-profile/bin/%s\n' "$name"
  else
    die "$name not found; set $var"
  fi
}

slugify() {
  local value
  value=$(printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '-' | sed -E 's/^-+|-+$//g; s/-+/-/g')
  if [[ -z "$value" ]]; then
    value=run
  fi
  printf '%s\n' "$value"
}

env_line() {
  printf '%s=%q\n' "$1" "$2"
}

remote_quote() {
  printf '%q' "$1"
}

setup_ssh_opts() {
  SSH_KEY=${VPSADMINOS_TEST_OFFLOAD_SSH_KEY:-${VPSADMINOS_OFFLOAD_SSH_KEY:-}}
  KNOWN_HOSTS=${VPSADMINOS_TEST_OFFLOAD_KNOWN_HOSTS:-${VPSADMINOS_OFFLOAD_KNOWN_HOSTS:-}}
  STRICT_HOST_KEY_CHECKING=${VPSADMINOS_TEST_OFFLOAD_STRICT_HOST_KEY_CHECKING:-yes}
  ssh_opts=()

  if [[ -n "$SSH_KEY" ]]; then
    ssh_opts+=(-i "$SSH_KEY" -o IdentitiesOnly=yes)
  fi

  if [[ -n "$KNOWN_HOSTS" ]]; then
    ssh_opts+=(-o "UserKnownHostsFile=$KNOWN_HOSTS")
  fi

  if [[ -n "$STRICT_HOST_KEY_CHECKING" ]]; then
    ssh_opts+=(-o "StrictHostKeyChecking=$STRICT_HOST_KEY_CHECKING")
  fi

  ssh_opts+=(
    -o BatchMode=yes
    -o "ConnectTimeout=$SSH_CONNECT_TIMEOUT"
    -o "ServerAliveInterval=$SSH_SERVER_ALIVE_INTERVAL"
    -o "ServerAliveCountMax=$SSH_SERVER_ALIVE_COUNT_MAX"
  )
}

ssh_opts_string() {
  local out=()
  local opt
  for opt in "${ssh_opts[@]}"; do
    out+=("$opt")
  done
  printf '%s' "${out[*]}"
}

ssh_run() {
  ssh_with_timeout "$SSH_COMMAND_TIMEOUT" -n "${ssh_opts[@]}" "$OFFLOAD_HOST" "$@"
}

ssh_poll() {
  ssh_with_timeout "$SSH_POLL_TIMEOUT" -n "${ssh_opts[@]}" "$OFFLOAD_HOST" "$@"
}

ssh_with_timeout() {
  local limit=$1
  shift

  if (( limit > 0 )); then
    timeout --foreground "$limit" ssh "$@"
  else
    ssh "$@"
  fi
}

ssh_stdin() {
  local limit=$1
  shift

  ssh_with_timeout "$limit" "${ssh_opts[@]}" "$OFFLOAD_HOST" "$@"
}

ssh_poll_stdin() {
  ssh_with_timeout "$SSH_POLL_TIMEOUT" "${ssh_opts[@]}" "$OFFLOAD_HOST" "$@"
}

save_manifest() {
  mkdir -p "$STATE_DIR"
  {
    env_line TEST_PATH "$TEST_PATH"
    env_line TEST_SLUG "$TEST_SLUG"
    env_line RUN_ID "$RUN_ID"
    env_line STATE_DIR "$STATE_DIR"
    env_line JSON_LINK "$JSON_LINK"
    env_line JSON_STORE "${JSON_STORE:-}"
    env_line RUNNER_LINK "$RUNNER_LINK"
    env_line RUNNER_STORE "${RUNNER_STORE:-}"
    env_line OFFLOAD_HOST "${OFFLOAD_HOST:-}"
    env_line LANES "$LANES"
    env_line UNIT_PREFIX "$UNIT_PREFIX"
    env_line REMOTE_RUN_ID "$REMOTE_RUN_ID"
    env_line REMOTE_STATE_BASE "$REMOTE_STATE_BASE"
    env_line SYSTEM "$SYSTEM"
    env_line TEST_TIMEOUT "$TEST_TIMEOUT"
    env_line TEST_JOBS "$TEST_JOBS"
    env_line STALE_TIMEOUT "$STALE_TIMEOUT"
    env_line STALE_STOP_GRACE "$STALE_STOP_GRACE"
    env_line STALE_DIAG_LINES "$STALE_DIAG_LINES"
    env_line STALE_DIAG_DIR "$STALE_DIAG_DIR"
    env_line STALE_TSV "$STALE_TSV"
    env_line PROGRESS_TSV "$PROGRESS_TSV"
    env_line SSH_CONNECT_TIMEOUT "$SSH_CONNECT_TIMEOUT"
    env_line SSH_SERVER_ALIVE_INTERVAL "$SSH_SERVER_ALIVE_INTERVAL"
    env_line SSH_SERVER_ALIVE_COUNT_MAX "$SSH_SERVER_ALIVE_COUNT_MAX"
    env_line SSH_COMMAND_TIMEOUT "$SSH_COMMAND_TIMEOUT"
    env_line SSH_POLL_TIMEOUT "$SSH_POLL_TIMEOUT"
    env_line SSH_DIAG_TIMEOUT "$SSH_DIAG_TIMEOUT"
    env_line REMOTE_PATH "$REMOTE_PATH"
    env_line REQUIRE_EVENTS "$REQUIRE_EVENTS"
    env_line FORWARDED_ENV_NAMES "$FORWARDED_ENV_NAMES"
  } >"$MANIFEST"
}

load_manifest() {
  [[ -f "$MANIFEST" ]] || die "missing manifest: $MANIFEST"
  # shellcheck disable=SC1090
  source "$MANIFEST"
}

require_test_path() {
  [[ -n "$TEST_PATH" ]] || die "test path is required"
}

require_offload_host() {
  [[ -n "$OFFLOAD_HOST" ]] || die "set VPSADMINOS_TEST_OFFLOAD_HOST"
}

require_lanes_file() {
  [[ -f "$LANES_FILE" ]] || die "missing lanes file: $LANES_FILE"
}

split_words() {
  tr ',:' '  ' <<<"$1"
}

name_in_forward_list() {
  local needle=$1
  local name

  for name in $(split_words "$FORWARD_ENV_NAMES_REQUESTED"); do
    [[ "$name" == "$needle" ]] && return 0
  done

  return 1
}

name_matches_forward_prefix() {
  local needle=$1
  local prefix

  for prefix in $(split_words "$FORWARD_ENV_PREFIXES"); do
    [[ -n "$prefix" ]] || continue
    [[ "$needle" == "$prefix"* ]] && return 0
  done

  return 1
}

collect_forward_env() {
  local line name value include

  FORWARDED_ENV_SPEC=
  FORWARDED_ENV_NAMES=

  while IFS='=' read -r name value; do
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue

    include=0
    if name_in_forward_list "$name" || name_matches_forward_prefix "$name"; then
      include=1
    fi

    if [[ "$include" == 1 ]]; then
      FORWARDED_ENV_SPEC+="${name}=${value}"$'\n'
      if [[ -n "$FORWARDED_ENV_NAMES" ]]; then
        FORWARDED_ENV_NAMES+=","
      fi
      FORWARDED_ENV_NAMES+="$name"
    fi
  done < <(env | LC_ALL=C sort)
}

build_json() {
  require_test_path
  mkdir -p "$STATE_DIR"

  log "building focused JSON for $TEST_PATH"
  "$NIX_BUILD" "$repo_root/test-runner/nix/evaluate-tests.nix" \
    --arg repoRoot "$repo_root" \
    --argstr system "$SYSTEM" \
    --argstr mode testJson \
    --argstr testPath "$TEST_PATH" \
    --out-link "$JSON_LINK"

  JSON_STORE=$(readlink -f "$JSON_LINK")
  [[ "$JSON_STORE" == /nix/store/* ]] || die "JSON out-link did not resolve to a Nix store path: $JSON_STORE"

  log "building packaged test JSON runner"
  "$NIX" --extra-experimental-features 'nix-command flakes' build \
    --out-link "$RUNNER_LINK" \
    "$repo_root#test-runner" >/dev/null

  RUNNER_STORE=$(readlink -f "$RUNNER_LINK")
  [[ -x "$RUNNER_STORE/bin/test-json-runner" ]] \
    || die "packaged test-json-runner missing from $RUNNER_STORE"

  save_manifest
  log "state: $STATE_DIR"
  log "json: $JSON_STORE"
  log "runner: $RUNNER_STORE"
}

copy_closures() {
  load_manifest
  require_offload_host
  [[ -n "$JSON_STORE" && -e "$JSON_STORE" ]] || die "JSON store path missing; run build-json first"
  [[ -n "$RUNNER_STORE" && -e "$RUNNER_STORE" ]] || die "runner store path missing; run build-json first"

  log "copying JSON and runner closures to $OFFLOAD_HOST"
  NIX_SSHOPTS="$(ssh_opts_string)" "$NIX_COPY_CLOSURE" --to "$OFFLOAD_HOST" "$JSON_STORE" "$RUNNER_STORE"
}

launch_lanes() {
  load_manifest
  require_offload_host
  [[ "$LANES" =~ ^[1-9][0-9]*$ ]] || die "VPSADMINOS_TEST_OFFLOAD_LANES must be a positive integer"
  collect_forward_env
  FORWARDED_ENV_SPEC_B64=$(printf '%s' "$FORWARDED_ENV_SPEC" | base64 | tr -d '\n')

  log "launching $LANES lane(s) on $OFFLOAD_HOST"
  ssh_stdin "$SSH_COMMAND_TIMEOUT" \
    env JSON_STORE="$JSON_STORE" \
        RUNNER="$RUNNER_STORE/bin/test-json-runner" \
        TEST_PATH="$TEST_PATH" \
        TEST_TIMEOUT="$TEST_TIMEOUT" \
        TEST_JOBS="$TEST_JOBS" \
        TEST_SYSTEM="$SYSTEM" \
        LANES="$LANES" \
        UNIT_PREFIX="$UNIT_PREFIX" \
        REMOTE_RUN_ID="$REMOTE_RUN_ID" \
        REMOTE_STATE_BASE="$REMOTE_STATE_BASE" \
        REMOTE_PATH="$REMOTE_PATH" \
        FORWARDED_ENV_SPEC_B64="$FORWARDED_ENV_SPEC_B64" \
        bash -s >"$LANES_FILE.tmp" <<'REMOTE'
set -euo pipefail

test -e "$JSON_STORE"
test -x "$RUNNER"
mkdir -p "$REMOTE_STATE_BASE/$REMOTE_RUN_ID"

FORWARDED_ENV_SPEC=$(printf '%s' "$FORWARDED_ENV_SPEC_B64" | base64 -d)
forwarded_env_args=()
while IFS= read -r env_line; do
  [ -n "$env_line" ] || continue
  forwarded_env_args+=(--setenv="$env_line")
done <<<"${FORWARDED_ENV_SPEC:-}"

for lane in $(seq 1 "$LANES"); do
  state="$REMOTE_STATE_BASE/$REMOTE_RUN_ID/lane${lane}"
  unit="${UNIT_PREFIX}-lane${lane}"
  launched_epoch="$(date +%s)"
  mkdir -p "$state"
  touch "$state/.vpsadminos-test-json-offload"
  systemctl reset-failed "${unit}.service" >/dev/null 2>&1 || true
  systemd-run \
    --unit="$unit" \
    --collect \
    --no-block \
    --property=WorkingDirectory=/root \
    --setenv=PATH="$REMOTE_PATH" \
    --setenv=TEST_PATH="$TEST_PATH" \
    --setenv=TEST_TIMEOUT="$TEST_TIMEOUT" \
    --setenv=TEST_JOBS="$TEST_JOBS" \
    --setenv=TEST_SYSTEM="$TEST_SYSTEM" \
    "${forwarded_env_args[@]}" \
    "$RUNNER" "$JSON_STORE" "$state" >/dev/null
  printf '%s\t%s\t%s\t%s\n' "$lane" "$unit" "$state" "$launched_epoch"
done
REMOTE

  mv "$LANES_FILE.tmp" "$LANES_FILE"
  save_manifest
  log "lanes: $LANES_FILE"
}

status_lanes() {
  load_manifest
  require_offload_host
  require_lanes_file

  while IFS=$'\t' read -r lane unit state launched_epoch _; do
    [[ -n "$lane" ]] || continue
    quoted_unit=$(remote_quote "${unit}.service")
    status=$(
      ssh_poll "systemctl show $quoted_unit --no-page --property=ActiveState --property=SubState --property=Result --property=ExecMainCode --property=ExecMainStatus 2>/dev/null || true"
    )
    printf 'lane=%s unit=%s state=%s\n%s\n' "$lane" "$unit" "$state" "$status"
  done <"$LANES_FILE"
}

