REMOTE
  ); then
    printf -- '-1\t-1\t-1\t\n'
    return 0
  fi

  IFS=$'\t' read -r rows log_bytes log_mtime fatal_reason _ <<<"$stats"
  case "$rows" in
    ''|*[!0-9]*) rows=-1 ;;
  esac
  case "$log_bytes" in
    ''|*[!0-9]*) log_bytes=-1 ;;
  esac
  case "$log_mtime" in
    ''|*[!0-9]*) log_mtime=-1 ;;
  esac
  fatal_reason=${fatal_reason//$'\t'/ }

  printf '%s\t%s\t%s\t%s\n' "$rows" "$log_bytes" "$log_mtime" "$fatal_reason"
}

watch_remote_snapshot() {
  local lanes_b64

  lanes_b64=$(base64 <"$LANES_FILE" | tr -d '\n')
  ssh_poll_stdin env LANES_B64="$lanes_b64" bash -s <<'REMOTE'
set -euo pipefail

printf '__meta__\tremote_epoch\t%s\n' "$(date +%s 2>/dev/null || printf 0)"
printf '__meta__\tloadavg\t%s\n' "$(cat /proc/loadavg 2>/dev/null || true)"
printf '__meta__\tnproc\t%s\n' "$(nproc 2>/dev/null || true)"

printf '%s' "$LANES_B64" | base64 -d |
  while IFS=$'\t' read -r lane unit state launched_epoch _; do
    [ -n "$lane" ] || continue

    svc="${unit}.service"
    status="$(
      timeout 8 systemctl show "$svc" --no-page \
        --property=ActiveState \
        --property=SubState \
        --property=Result \
        --property=ExecMainStatus \
        --property=ActiveEnterTimestamp 2>/dev/null || true
    )"
    active="$(printf '%s\n' "$status" | sed -n 's/^ActiveState=//p')"
    sub="$(printf '%s\n' "$status" | sed -n 's/^SubState=//p')"
    result="$(printf '%s\n' "$status" | sed -n 's/^Result=//p')"
    exec_status="$(printf '%s\n' "$status" | sed -n 's/^ExecMainStatus=//p')"
    active_ts="$(printf '%s\n' "$status" | sed -n 's/^ActiveEnterTimestamp=//p')"
    active_since_epoch=""
    if [ -n "$active_ts" ] && [ "$active_ts" != n/a ]; then
      active_since_epoch="$(timeout 3 date -d "$active_ts" +%s 2>/dev/null || true)"
    fi

    rows=0
    log_bytes=0
    log_mtime=0
    latest=""
    fatal_reason=""
    while IFS= read -r -d '' logfile; do
      size="$(stat -c %s "$logfile" 2>/dev/null || printf 0)"
      mtime="$(stat -c %Y "$logfile" 2>/dev/null || printf 0)"
      case "$size" in
        ''|*[!0-9]*) size=0 ;;
      esac
      case "$mtime" in
        ''|*[!0-9]*) mtime=0 ;;
      esac
      log_bytes=$((log_bytes + size))
      if [ "$mtime" -gt "$log_mtime" ]; then
        log_mtime=$mtime
      fi
      scan="$(
        awk '
          {
            line = $0
            if (match(line, /(proxy-lock-badneighbor-(progress|result|summary)) /)) {
              rows += 1
              latest = line
            }
          }
          END {
            if (latest != "") {
              print rows "\t" latest
            } else {
              print rows "\t"
            }
          }
        ' "$logfile"
      )"
      file_rows="${scan%%	*}"
      file_latest="${scan#*	}"
      case "$file_rows" in
        ''|*[!0-9]*) file_rows=0 ;;
      esac
      rows=$((rows + file_rows))
      if [ -n "$file_latest" ]; then
        latest="$file_latest"
      fi
      if [ -z "$fatal_reason" ]; then
        fatal_reason="$(
          tail -n 2000 "$logfile" 2>/dev/null |
            awk '
              /Kernel panic|watchdog: BUG: soft lockup|BUG: unable to handle|Oops:|general protection fault|INFO: task .* blocked for more than|rcu: INFO: .*detected stalls|modprobe: ERROR: could not insert|Can.t mount root|VFS: Cannot open root device/ {
                line = $0
              }
              END {
                if (line != "") {
                  gsub(/[[:space:]]+/, " ", line)
                  print substr(line, 1, 180)
                }
              }
            '
        )"
      fi
    done < <(find "$state" -maxdepth 5 -type f \( -name test-runner.log -o -name 'machine-*.log' \) -print0 2>/dev/null)

    event="-"
    label="-"
    lock="-"
    timeout_value="-"
    classification="-"
    if [ -n "$latest" ]; then
      event="$(printf '%s\n' "$latest" | sed -nE 's/.*(proxy-lock-badneighbor-(progress|result|summary)) .*/\1/p')"
      label="$(printf '%s\n' "$latest" | sed -nE 's/.*"label":"([^"]+)".*/\1/p')"
      lock="$(printf '%s\n' "$latest" | sed -nE 's/.*"(lock_class|lock_type|operation)":"([^"]+)".*/\2/p')"
      timeout_value="$(printf '%s\n' "$latest" | sed -nE 's/.*"timeout":(true|false).*/\1/p')"
      classification="$(printf '%s\n' "$latest" | sed -nE 's/.*"classification":"([^"]+)".*/\1/p')"
      phase="$(printf '%s\n' "$latest" | sed -nE 's/.*"phase":"([^"]+)".*/\1/p')"
      [ -n "$event" ] || event="-"
      [ -n "$label" ] || label="-"
      [ -n "$lock" ] || lock="-"
      [ -n "$timeout_value" ] || timeout_value="-"
      [ -n "$classification" ] || classification="$phase"
      [ -n "$classification" ] || classification="-"
    fi

    fatal_reason="$(printf '%s' "$fatal_reason" | tr '\t\n' '  ')"
    printf '__lane__\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$lane" "$unit" "$state" "${launched_epoch:-}" "${active:-unknown}" \
      "${sub:-unknown}" "${result:-unknown}" "${exec_status:-unknown}" \
      "${active_since_epoch:-}" "$rows" "$log_bytes" "$log_mtime" \
      "$event" "$label" "$lock" "$timeout_value" "$classification" \
      "$fatal_reason"
  done
REMOTE
}

remote_epoch() {
  local epoch

  epoch=$(ssh_poll "date +%s" 2>/dev/null || true)
  case "$epoch" in
    ''|*[!0-9]*)
      date +%s
      ;;
    *)
      printf '%s\n' "$epoch"
      ;;
  esac
}

lane_active_since_epoch() {
  local unit=$1
  local quoted_unit ts epoch

  quoted_unit=$(remote_quote "${unit}.service")
  ts=$(
    ssh_poll "systemctl show $quoted_unit --no-page --property=ActiveEnterTimestamp 2>/dev/null | sed -n 's/^ActiveEnterTimestamp=//p' || true"
  )
  [[ -n "$ts" && "$ts" != n/a ]] || return 1

  epoch=$(
    ssh_poll "date -d $(remote_quote "$ts") +%s 2>/dev/null || true"
  )
  case "$epoch" in
    ''|*[!0-9]*)
      return 1
      ;;
    *)
      printf '%s\n' "$epoch"
      ;;
  esac
}

stop_stale_lane() {
  local lane=$1
  local unit=$2
  local state=$3
  local reason=$4
  local now diag_stamp diag_file

  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  diag_stamp=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$STALE_DIAG_DIR"
  diag_file="$STALE_DIAG_DIR/lane${lane}-${diag_stamp}.txt"

  log "capturing stale lane diagnostics for lane $lane ($unit): $diag_file"
  if ! ssh_stdin "$SSH_DIAG_TIMEOUT" \
    env UNIT="$unit" STATE="$state" DIAG_LINES="$STALE_DIAG_LINES" bash -s \
      >"${diag_file}.tmp" 2>&1 <<'REMOTE'
set +e

svc="${UNIT}.service"
lines="${DIAG_LINES:-400}"
case "$lines" in
  ''|*[!0-9]*) lines=400 ;;
esac

section() {
  printf '\n### %s\n' "$*"
}

section "capture"
date -u +%Y-%m-%dT%H:%M:%SZ
printf 'unit=%s\nstate=%s\n' "$svc" "$STATE"

section "host"
printf 'loadavg='
cat /proc/loadavg 2>/dev/null || true
printf 'nproc='
nproc 2>/dev/null || true
free -h 2>/dev/null || true
uptime 2>/dev/null || true

section "systemctl-show"
timeout 20 systemctl show "$svc" --no-page \
  --property=ActiveState \
  --property=SubState \
  --property=Result \
  --property=ExecMainCode \
  --property=ExecMainStatus \
  --property=MainPID \
  --property=ControlGroup \
  --property=ActiveEnterTimestamp \
  --property=StateChangeTimestamp || true

section "systemctl-status"
timeout 20 systemctl status "$svc" --no-pager -n "$lines" || true

section "journal"
timeout 30 journalctl -u "$svc" --no-pager -n "$lines" -o short-iso || true

section "lane-state-files"
timeout 20 find "$STATE" -maxdepth 5 -type f \
  -printf '%TY-%Tm-%TdT%TH:%TM:%TS %s %p\n' 2>/dev/null | sort || true

while IFS= read -r -d '' logfile; do
  section "lane-log $logfile"
  timeout 20 tail -n "$lines" "$logfile" || true
done < <(find "$STATE" -maxdepth 5 -type f \( -name test-runner.log -o -name 'machine-*.log' \) -print0 2>/dev/null)

while IFS= read -r -d '' result_file; do
  section "test-result $result_file"
  timeout 10 cat "$result_file" || true
done < <(find "$STATE" -maxdepth 5 -type f -name test-result.txt -print0 2>/dev/null)

section "unit-cgroup"
cg="$(systemctl show "$svc" --no-page --property=ControlGroup --value 2>/dev/null || true)"
if [ -n "$cg" ] && [ "$cg" != "/" ]; then
  timeout 20 systemd-cgls --no-pager "$cg" || true
fi

section "matching-processes"
timeout 20 ps -eo pid,ppid,stat,pcpu,pmem,etimes,wchan:32,comm,args --sort=pid |
  grep -E "(${UNIT}|test-json-runner|test-runner|osvm|qemu|ruby)" || true

section "host-dmesg-tail"
timeout 20 dmesg -T 2>/dev/null | tail -n "$lines" || true
REMOTE
  then
    log "stale lane diagnostic capture returned non-zero for lane $lane"
  fi
  mv "${diag_file}.tmp" "$diag_file"

  log "stopping stale lane $lane ($unit): $reason"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$now" "$lane" "$unit" "$state" "$reason" "$diag_file" >>"$STALE_TSV"

  ssh_stdin "$SSH_COMMAND_TIMEOUT" \
    env UNIT="$unit" GRACE="$STALE_STOP_GRACE" bash -s <<'REMOTE' || true
set -euo pipefail

svc="${UNIT}.service"
systemctl show "$svc" --no-page \
  --property=ActiveState \
  --property=SubState \
  --property=Result \
  --property=ExecMainStatus >&2 || true

systemctl kill --kill-whom=all --signal=TERM "$svc" >/dev/null 2>&1 || true
timeout "$GRACE" systemctl stop "$svc" >/dev/null 2>&1 || true

active="$(
  systemctl show "$svc" --no-page --property=ActiveState 2>/dev/null |
    sed -n 's/^ActiveState=//p'
)"
case "$active" in
  active|activating|deactivating|reloading)
    systemctl kill --kill-whom=all --signal=KILL "$svc" >/dev/null 2>&1 || true
    timeout 15 systemctl stop "$svc" >/dev/null 2>&1 || true
    ;;
esac
REMOTE
}

lanes_finished() {
  local lane unit state quoted_unit active

  while IFS=$'\t' read -r lane unit state launched_epoch _; do
    [[ -n "$lane" ]] || continue
    quoted_unit=$(remote_quote "${unit}.service")
    active=$(
      ssh_poll "systemctl show $quoted_unit --no-page --property=ActiveState 2>/dev/null | sed -n 's/^ActiveState=//p' || true"
    )

    case "$active" in
      active|activating|deactivating|reloading)
        return 1
        ;;
    esac
  done <"$LANES_FILE"

  return 0
}

load_watch_progress() {
  local lane rows progress log_bytes log_mtime activity_epoch activity_reason _rest

  [[ -f "$PROGRESS_TSV" ]] || return 0

  while IFS=$'\t' read -r lane rows progress log_bytes log_mtime activity_epoch activity_reason _rest; do
    [[ "$lane" != lane && -n "$lane" ]] || continue
    case "$rows" in
      ''|*[!0-9]*) continue ;;
    esac
    case "$progress" in
      ''|*[!0-9]*) continue ;;
    esac
    case "$log_bytes" in
      ''|*[!0-9]*) log_bytes=0 ;;
    esac
    case "$log_mtime" in
      ''|*[!0-9]*) log_mtime=0 ;;
    esac
    case "$activity_epoch" in
      ''|*[!0-9]*) activity_epoch=$progress ;;
    esac
    [[ -n "$activity_reason" ]] || activity_reason=progress
    last_rows[$lane]=$rows
    last_progress[$lane]=$progress
    last_log_bytes[$lane]=$log_bytes
    last_log_mtime[$lane]=$log_mtime
    last_activity[$lane]=$activity_epoch
    last_activity_reason[$lane]=$activity_reason
  done <"$PROGRESS_TSV"
}

save_watch_progress() {
  local lane

  {
    printf 'lane\trows\tlast_progress_epoch\tlog_bytes\tnewest_log_mtime\tlast_activity_epoch\tactivity_reason\n'
    for lane in "${!last_rows[@]}"; do
      [[ -n "${last_progress[$lane]:-}" ]] || continue
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$lane" \
        "${last_rows[$lane]}" \
        "${last_progress[$lane]}" \
        "${last_log_bytes[$lane]:-0}" \
        "${last_log_mtime[$lane]:-0}" \
        "${last_activity[$lane]:-${last_progress[$lane]}}" \
        "${last_activity_reason[$lane]:-progress}"
    done
  } >"${PROGRESS_TSV}.tmp"
  mv "${PROGRESS_TSV}.tmp" "$PROGRESS_TSV"
}

watch_lanes() {
  load_manifest
  require_offload_host
  require_lanes_file

  local deadline now now_epoch lane unit state launched_epoch active rows age
  local active_since progress_changed activity log_bytes log_mtime fatal_reason base_epoch reason
  local snapshot record key value loadavg nproc_value snapshot_ok all_finished
  local lane_field unit_field state_field launched_field active_field sub_field result_field
  local exec_status_field active_since_field rows_field log_bytes_field log_mtime_field
  local event_field label_field lock_field timeout_field classification_field fatal_field
  local log_kib log_age now_iso
  declare -A last_rows=()
  declare -A last_progress=()
  declare -A last_log_bytes=()
  declare -A last_log_mtime=()
  declare -A last_activity=()
  declare -A last_activity_reason=()
  declare -A stale_stopped=()
  declare -A snap_unit=()
  declare -A snap_state=()
  declare -A snap_launched=()
  declare -A snap_active=()
  declare -A snap_sub=()
  declare -A snap_result=()
  declare -A snap_exec_status=()
  declare -A snap_active_since=()
  declare -A snap_rows=()
  declare -A snap_log_bytes=()
  declare -A snap_log_mtime=()
  declare -A snap_event=()
  declare -A snap_label=()
  declare -A snap_lock=()
  declare -A snap_timeout=()
  declare -A snap_classification=()
  declare -A snap_fatal=()

  load_watch_progress

  if (( STALE_TIMEOUT > 0 )) && [[ ! -f "$STALE_TSV" ]]; then
    printf 'time_utc\tlane\tunit\tstate\treason\tdiagnostic_file\n' >"$STALE_TSV"
  fi

  deadline=$((SECONDS + WAIT_TIMEOUT))

  while true; do
    now_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    now=$SECONDS
    now_epoch=$(date +%s)
    loadavg=
    nproc_value=
    snapshot_ok=0
    snap_unit=()
    snap_state=()
    snap_launched=()
    snap_active=()
    snap_sub=()
    snap_result=()
    snap_exec_status=()
    snap_active_since=()
    snap_rows=()
    snap_log_bytes=()
    snap_log_mtime=()
    snap_event=()
    snap_label=()
    snap_lock=()
    snap_timeout=()
    snap_classification=()
    snap_fatal=()

    if snapshot=$(watch_remote_snapshot 2>/dev/null); then
      snapshot_ok=1
      while IFS=$'\t' read -r record key value unit_field state_field launched_field \
          active_field sub_field result_field exec_status_field active_since_field \
          rows_field log_bytes_field log_mtime_field event_field label_field \
          lock_field timeout_field classification_field fatal_field _; do
        case "$record" in
          __meta__)
            case "$key" in
              remote_epoch)
                case "$value" in
                  ''|*[!0-9]*) ;;
                  *) now_epoch=$value ;;
                esac
                ;;
              loadavg)
                loadavg=$value
                ;;
              nproc)
                nproc_value=$value
                ;;
            esac
            ;;
          __lane__)
            lane_field=$key
            snap_unit[$lane_field]=$value
            snap_state[$lane_field]=$unit_field
            snap_launched[$lane_field]=$state_field
            snap_active[$lane_field]=$launched_field
            snap_sub[$lane_field]=$active_field
            snap_result[$lane_field]=$sub_field
            snap_exec_status[$lane_field]=$result_field
            snap_active_since[$lane_field]=$exec_status_field
            snap_rows[$lane_field]=$active_since_field
            snap_log_bytes[$lane_field]=$rows_field
            snap_log_mtime[$lane_field]=$log_bytes_field
            snap_event[$lane_field]=$log_mtime_field
            snap_label[$lane_field]=$event_field
            snap_lock[$lane_field]=$label_field
            snap_timeout[$lane_field]=$lock_field
            snap_classification[$lane_field]=$timeout_field
            snap_fatal[$lane_field]=${classification_field:-}
            ;;
        esac
      done <<<"$snapshot"
    fi

    printf '\n[%s] %s\n' "$now_iso" "$OFFLOAD_HOST"
    if (( snapshot_ok )); then
      [[ -n "$loadavg" ]] && printf 'loadavg=%s\n' "$loadavg"
      [[ -n "$nproc_value" ]] && printf 'nproc=%s\n' "$nproc_value"
    else
      printf 'snapshot=unavailable poll_timeout=%ss\n' "$SSH_POLL_TIMEOUT"
    fi
    printf '%-5s %-11s %-10s %-8s %-5s %-7s %-8s %-28s %-18s %-9s %-22s %s\n' \
      lane active sub result rows logKB logAge event label lock timeout classification

    while IFS=$'\t' read -r lane unit state launched_epoch _; do
      [[ -n "$lane" ]] || continue
      active=${snap_active[$lane]:-unknown}
      rows=${snap_rows[$lane]:-0}
      log_bytes=${snap_log_bytes[$lane]:-0}
      log_mtime=${snap_log_mtime[$lane]:-0}
      case "$log_bytes" in
        ''|*[!0-9]*) log_kib=- ;;
        *) log_kib=$(((log_bytes + 1023) / 1024)) ;;
      esac
      case "$log_mtime" in
        ''|*[!0-9]*|0) log_age=- ;;
        *)
          log_age=$((now_epoch - log_mtime))
          (( log_age < 0 )) && log_age=0
          ;;
      esac
      printf '%-5s %-11s %-10s %-8s %-5s %-7s %-8s %-28s %-18s %-9s %-22s %s\n' \
        "$lane" \
        "$active" \
        "${snap_sub[$lane]:-unknown}" \
        "${snap_result[$lane]:-unknown}/${snap_exec_status[$lane]:-unknown}" \
        "$rows" \
        "$log_kib" \
        "$log_age" \
        "${snap_event[$lane]:--}" \
        "${snap_label[$lane]:--}" \
        "${snap_lock[$lane]:--}" \
        "${snap_timeout[$lane]:--}" \
        "${snap_classification[$lane]:--}"
    done <"$LANES_FILE"

    all_finished=0
    if (( snapshot_ok )); then
      all_finished=1
    fi

    if (( snapshot_ok && STALE_TIMEOUT > 0 )); then
      progress_changed=0
      while IFS=$'\t' read -r lane unit state launched_epoch _; do
        [[ -n "$lane" ]] || continue
        active=${snap_active[$lane]:-unknown}
        case "$active" in
          active|activating|deactivating|reloading)
            all_finished=0
            ;;
          ''|unknown)
            all_finished=0
            continue
            ;;
          *)
            continue
            ;;
        esac

        rows=${snap_rows[$lane]:--1}
        if [[ "$rows" == -1 ]]; then
          continue
        fi
        log_bytes=${snap_log_bytes[$lane]:-0}
        log_mtime=${snap_log_mtime[$lane]:-0}
        case "$log_bytes" in
          ''|*[!0-9]*) log_bytes=0 ;;
        esac
        case "$log_mtime" in
          ''|*[!0-9]*) log_mtime=0 ;;
        esac
        fatal_reason=${snap_fatal[$lane]:-}
        if [[ -n "${fatal_reason:-}" && -z "${stale_stopped[$lane]:-}" ]]; then
          stale_stopped[$lane]=1
          stop_stale_lane "$lane" "$unit" "$state" \
            "fatal guest log pattern after rows=${rows}: ${fatal_reason}"
          continue
        fi

        if [[ -z "${last_rows[$lane]+set}" ]]; then
          last_rows[$lane]=$rows
          last_log_bytes[$lane]=$log_bytes
          last_log_mtime[$lane]=$log_mtime
          case "$launched_epoch" in
            ''|*[!0-9]*)
              active_since=${snap_active_since[$lane]:-}
              ;;
            *)
              active_since=$launched_epoch
              ;;
          esac
          case "${active_since:-}" in
            ''|*[!0-9]*) active_since=$now_epoch ;;
          esac
          if (( log_mtime > 0 )); then
            base_epoch=$log_mtime
          else
            base_epoch=$active_since
          fi
          last_progress[$lane]=$base_epoch
          last_activity[$lane]=$base_epoch
          if (( rows > 0 )); then
            last_activity_reason[$lane]=existing-row-log
          elif (( log_bytes > 0 || log_mtime > 0 )); then
            last_activity_reason[$lane]=existing-log
          else
            last_activity_reason[$lane]=launch
          fi
          progress_changed=1
        elif [[ "${last_rows[$lane]}" != "$rows" ]]; then
          last_rows[$lane]=$rows
          last_progress[$lane]=$now_epoch
          last_log_bytes[$lane]=$log_bytes
          last_log_mtime[$lane]=$log_mtime
          last_activity[$lane]=$now_epoch
          last_activity_reason[$lane]=row
          progress_changed=1
        elif [[ "${last_log_bytes[$lane]:-0}" != "$log_bytes" || "${last_log_mtime[$lane]:-0}" != "$log_mtime" ]]; then
          last_log_bytes[$lane]=$log_bytes
          last_log_mtime[$lane]=$log_mtime
          last_activity[$lane]=$now_epoch
          last_activity_reason[$lane]=log
          progress_changed=1
        fi

        if (( progress_changed )); then
          save_watch_progress
          progress_changed=0
        fi

        activity=${last_activity[$lane]:-${last_progress[$lane]:-$now_epoch}}
        age=$((now_epoch - activity))
        if (( age < 0 )); then
          last_activity[$lane]=$now_epoch
          last_activity_reason[$lane]=clock-reset
          save_watch_progress
          continue
        fi

        if (( age >= STALE_TIMEOUT )) && [[ -z "${stale_stopped[$lane]:-}" ]]; then
          stale_stopped[$lane]=1
          reason=${last_activity_reason[$lane]:-unknown}
          stop_stale_lane "$lane" "$unit" "$state" \
            "no proxy-exec progress/result/summary row or lane log activity for ${age}s (rows=${rows} log_bytes=${log_bytes} log_mtime=${log_mtime} last_activity=${reason})"
        fi
      done <"$LANES_FILE"
    elif (( snapshot_ok )); then
      while IFS=$'\t' read -r lane unit state launched_epoch _; do
        [[ -n "$lane" ]] || continue
        active=${snap_active[$lane]:-unknown}
        case "$active" in
          active|activating|deactivating|reloading)
            all_finished=0
            ;;
          ''|unknown)
            all_finished=0
            ;;
        esac
      done <"$LANES_FILE"
    fi

    if (( snapshot_ok && all_finished )); then
      log "all lanes stopped; collecting artifacts"
      collect_results
      return 0
    fi

    if (( now >= deadline )); then
      status_lanes || true
      die "timed out watching remote lanes after ${WAIT_TIMEOUT}s"
    fi

    sleep "$WATCH_INTERVAL"
  done
}

wait_lanes() {
  load_manifest
  require_offload_host
  require_lanes_file

  local deadline now
  deadline=$((SECONDS + WAIT_TIMEOUT))

  while true; do
    if lanes_finished; then
      log "all lanes stopped"
      return 0
    fi

    now=$SECONDS
    if (( now >= deadline )); then
      status_lanes || true
      die "timed out waiting for remote lanes after ${WAIT_TIMEOUT}s"
    fi

    sleep "$WAIT_INTERVAL"
  done
}

collect_results() {
  load_manifest
  require_offload_host
  require_lanes_file

  : >"$EVENTS_TSV"
  : >"$LANE_RESULTS_TSV"

  while IFS=$'\t' read -r lane unit state launched_epoch _; do
    [[ -n "$lane" ]] || continue
    log "collecting lane $lane from $state"
    ssh_stdin "$SSH_COMMAND_TIMEOUT" \
      env LANE="$lane" UNIT="$unit" STATE="$state" bash -s <<'REMOTE' >>"$LANE_RESULTS_TSV"
set -euo pipefail

found=0
while IFS= read -r -d '' result_file; do
  found=1
  result="$(tr '\n\t' '  ' <"$result_file" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
  log_file="$(dirname "$result_file")/test-runner.log"
  diagnostic_line=""
  if [ -f "$log_file" ]; then
    diagnostic_line="$(
      awk '
        /Exception occurred|Timeout occurred|Test .* failed after|tests should have succeeded|Unexpectedly failed/ {
          line=$0
        }
        NF {
          last=$0
        }
        END {
          if (line != "") {
            print line
          } else {
            print last
          }
        }
      ' "$log_file" | tr '\t' ' '
    )"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$LANE" "$UNIT" "$result_file" "$result" "$log_file" "$diagnostic_line"
done < <(find "$STATE" -maxdepth 5 -type f -name test-result.txt -print0 2>/dev/null)

if [ "$found" -eq 0 ]; then
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$LANE" "$UNIT" "$STATE" "missing" "" "no test-result.txt under lane state"
fi
REMOTE

    ssh_stdin "$SSH_COMMAND_TIMEOUT" \
      env LANE="$lane" UNIT="$unit" STATE="$state" bash -s <<'REMOTE' >>"$EVENTS_TSV"
set -euo pipefail

find "$STATE" -maxdepth 5 -type f -name test-runner.log -print0 2>/dev/null |
  while IFS= read -r -d '' logfile; do
    awk -v lane="$LANE" -v unit="$UNIT" -v logfile="$logfile" '
      {
        line = $0
        if (match(line, /(proxy-lock-badneighbor-(result|summary)) /)) {
          event = substr(line, RSTART, RLENGTH - 1)
          payload = substr(line, RSTART + RLENGTH)
          printf "%s\t%s\t%s\t%s\t%s\n", lane, unit, logfile, event, payload
        }
      }
    ' "$logfile"
