+void vpsadminos_nfqueue_livepatch_post_patch(void)
+{
+	struct klp_state *prev_state;
+
+	WRITE_ONCE(vpsadminos_nfqueue_state.data,
+		   VPSADMINOS_NFQUEUE_STATE_ACTIVE);
