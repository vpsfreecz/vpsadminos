+{
+	struct ceph_auth_handshake *auth;
+	struct kvec *auth_kvec;
+	size_t auth_len;
+	int auth_proto;
+
+	if (con->state != CEPH_CON_S_V1_CONNECT_MSG || !con->v1.auth)
+		return 0;
