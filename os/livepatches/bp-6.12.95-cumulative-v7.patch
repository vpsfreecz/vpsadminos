+	u64 result;
+};
+
+static void text_poke_cmpxchg64_fn(void *dst, const void *src, size_t len)
+{
+	struct text_poke_cmpxchg64_args *args = (void *)src;
+
+	(void)len;
+	args->result = arch_sync_cmpxchg((u64 *)dst, args->old, args->new);
