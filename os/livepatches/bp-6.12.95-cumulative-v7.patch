+					 VPSADMINOS_KLP_V7_CHECKPOINT_ID_LO),
+	.inventory_id = VPSADMINOS_KLP_ID(LIVEPATCH_INVENTORY_ID_HI,
+					  LIVEPATCH_INVENTORY_ID_LO),
