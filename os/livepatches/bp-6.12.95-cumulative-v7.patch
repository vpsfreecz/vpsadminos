+					priv->clone = NULL;
+				} else {
+					vpsadminos_pipapo_clone_state_free(clone);
+				}
+			}
+		}
+
+		mutex_unlock(&nft_net->commit_mutex);
+	}
+	up_read(&net_rwsem);
