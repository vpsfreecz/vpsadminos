+void rpc_cancel_client(struct rpc_clnt *clnt)
+{
+	struct rpc_task *task;
+
+	spin_lock(&clnt->cl_lock);
+	WRITE_ONCE(clnt->cl_shutdown, true);
+	list_for_each_entry(task, &clnt->cl_tasks, tk_task) {
+		if (RPC_IS_ACTIVATED(task))
