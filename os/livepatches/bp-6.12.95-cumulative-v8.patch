+static bool __maybe_unused vpsadminos_klp_release_is(const char *release)
+{
+	bool matches;
+
+	down_read(&uts_sem);
+	matches = !strcmp(init_uts_ns.name.release, release);
+	up_read(&uts_sem);
+	return matches;
+}
