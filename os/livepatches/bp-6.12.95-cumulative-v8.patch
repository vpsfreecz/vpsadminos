+static int klp_transition_range_cmp(const void *left, const void *right)
+{
+	const struct klp_transition_range *a = left;
+	const struct klp_transition_range *b = right;
+
+	if (a->start < b->start)
+		return -1;
+	if (a->start > b->start)
+		return 1;
+	if (a->end < b->end)
+		return -1;
+	if (a->end > b->end)
+		return 1;
+	return 0;
+}
