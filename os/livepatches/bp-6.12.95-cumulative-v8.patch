+static unsigned int vpsadminos_klp_patch_order(struct klp_patch *patch)
+{
+	struct klp_patch *ordered;
+	unsigned int order = 0;
+
+	klp_for_each_patch(ordered) {
+		if (ordered == patch)
+			return order;
+		order++;
+	}
+	return UINT_MAX;
