+
+static struct vpsadminos_klp_dependency_state *vpsadminos_checkpoint_old_dependency;
+static struct vpsadminos_klp_dependency_state *vpsadminos_checkpoint_dependency;
+static struct vpsadminos_klp_foundation_state *vpsadminos_checkpoint_foundation;
+static struct vpsadminos_klp_artifact_token *vpsadminos_checkpoint_artifact;
+static struct vpsadminos_klp_dependency_absorb *vpsadminos_checkpoint_absorb;
+static bool vpsadminos_checkpoint_committed;
+
+static void vpsadminos_v7_checkpoint_terminal(struct module *owner,
+					       bool enabled, void *data)
+{
+	struct vpsadminos_klp_dependency_state *dependency;
+	struct vpsadminos_klp_foundation_state *foundation;
+	struct klp_patch *patch = data;
+
+	if (WARN_ON_ONCE(!owner || !patch || patch->mod != owner))
+		return;
+	if (enabled && vpsadminos_checkpoint_committed)
+		return;
+	if (enabled) {
+		if (WARN_ON_ONCE(!vpsadminos_checkpoint_old_dependency ||
+				 !vpsadminos_checkpoint_absorb ||
+				 !vpsadminos_checkpoint_dependency ||
+				 !vpsadminos_checkpoint_foundation ||
+				 !vpsadminos_checkpoint_artifact))
+			return;
+		dependency = vpsadminos_checkpoint_old_dependency;
+		dependency->commit_absorb(vpsadminos_checkpoint_absorb);
+		vpsadminos_checkpoint_absorb = NULL;
+		vpsadminos_checkpoint_old_dependency = NULL;
+		if (WARN_ON_ONCE(!vpsadminos_checkpoint_dependency->active ||
+				 vpsadminos_checkpoint_dependency->owner != owner ||
+				 vpsadminos_checkpoint_dependency->foundation !=
+					vpsadminos_checkpoint_foundation ||
+				 vpsadminos_checkpoint_foundation->dependency !=
+					vpsadminos_checkpoint_dependency ||
+				 vpsadminos_checkpoint_foundation->artifact !=
+					vpsadminos_checkpoint_artifact))
+			return;
+		vpsadminos_checkpoint_foundation->owner = owner;
+		vpsadminos_checkpoint_foundation->owner_id =
+			vpsadminos_v7_checkpoint_spec.artifact_id;
+		/* Publish the completed checkpoint foundation contract. */
+		smp_store_release(&vpsadminos_checkpoint_foundation->active, true);
+		vpsadminos_coverage.owner = owner;
+		vpsadminos_coverage.lifetime = vpsadminos_checkpoint_artifact;
+		vpsadminos_coverage.owner_token =
+			VPSADMINOS_KLP_ID(VPSADMINOS_KLP_V7_CHECKPOINT_ID_HI,
+					  VPSADMINOS_KLP_V7_CHECKPOINT_ID_LO);
+		vpsadminos_coverage.final_token =
+			vpsadminos_coverage.owner_token;
+		WRITE_ONCE(vpsadminos_coverage.completed_artifacts, BIT_ULL(0));
+		smp_store_release(&vpsadminos_coverage.active, true);
+		smp_store_release(&vpsadminos_coverage.complete, true);
+		WRITE_ONCE(vpsadminos_generation_active, true);
+		WRITE_ONCE(vpsadminos_generation_complete, true);
+		vpsadminos_publish_identity();
+		vpsadminos_checkpoint_committed = true;
+		return;
+	}
+
+	if (!vpsadminos_checkpoint_committed ||
+	    WARN_ON_ONCE(!vpsadminos_checkpoint_dependency ||
+			 !vpsadminos_checkpoint_foundation ||
+			 !vpsadminos_checkpoint_artifact))
+		return;
+	dependency = vpsadminos_checkpoint_dependency;
+	foundation = vpsadminos_checkpoint_foundation;
+	vpsadminos_restore_identity();
+	WRITE_ONCE(vpsadminos_generation_complete, false);
+	WRITE_ONCE(vpsadminos_generation_active, false);
+	smp_store_release(&vpsadminos_coverage.complete, false);
+	smp_store_release(&vpsadminos_coverage.active, false);
+	vpsadminos_coverage.owner = NULL;
+	vpsadminos_coverage.lifetime = NULL;
+	foundation->deactivate(foundation);
+	if (WARN_ON_ONCE(foundation->active))
+		return;
+	/* Retire the checkpoint dependency contract after foundation teardown. */
+	smp_store_release(&dependency->active, false);
+	dependency->foundation = NULL;
+	dependency->owner = NULL;
+	dependency->owner_id = VPSADMINOS_KLP_ID(0, 0);
+	vpsadminos_checkpoint_artifact = NULL;
+	vpsadminos_checkpoint_foundation = NULL;
+	vpsadminos_checkpoint_dependency = NULL;
+	vpsadminos_checkpoint_committed = false;
+}
+
+int vpsadminos_v7_checkpoint_pre_patch(struct klp_object *obj)
+{
+	struct vpsadminos_klp_dependency_state *old_dependency, *dependency;
+	struct vpsadminos_klp_foundation_state *foundation;
+	struct vpsadminos_klp_coverage_state *coverage;
+	struct vpsadminos_klp_id checkpoint_guard_id =
+		VPSADMINOS_KLP_ID(VPSADMINOS_KLP_V7_CHECKPOINT_GUARD_ID_HI,
+				  VPSADMINOS_KLP_V7_CHECKPOINT_GUARD_ID_LO);
+	struct klp_patch *patch = vpsadminos_klp_object_patch(obj);
+	struct klp_state *record;
+	int ret;
+
+	if (!patch || patch != klp_transition_patch || !patch->replace ||
+	    list_is_singular(&klp_patches) ||
+	    klp_get_prev_state(VPSADMINOS_KLP_FOUNDATION_STATE_ID) ||
+	    klp_get_prev_state(VPSADMINOS_KLP_COVERAGE_STATE_ID))
+		return -EINVAL;
+	record = klp_get_prev_state(VPSADMINOS_KLP_DEPENDENCY_STATE_ID);
+	old_dependency = record ? record->data : NULL;
+	record = klp_get_state(patch, VPSADMINOS_KLP_DEPENDENCY_STATE_ID);
+	dependency = record ? record->data : NULL;
+	record = klp_get_state(patch, VPSADMINOS_KLP_FOUNDATION_STATE_ID);
+	foundation = record ? record->data : NULL;
+	record = klp_get_state(patch, VPSADMINOS_KLP_COVERAGE_STATE_ID);
+	coverage = record ? record->data : NULL;
+	if (!old_dependency ||
+	    old_dependency->magic != VPSADMINOS_KLP_DEPENDENCY_MAGIC ||
+	    old_dependency->abi_version != VPSADMINOS_KLP_DEPENDENCY_STATE_VERSION ||
+	    /* Pairs with clean checkpoint-guard activation. */
+	    !smp_load_acquire(&old_dependency->active) ||
+	    old_dependency->absorbing || !old_dependency->owner ||
+	    strcmp(old_dependency->owner->name, "lp7_checkpoint_guard") ||
+	    !vpsadminos_klp_id_equal(&old_dependency->owner_id,
+				     &checkpoint_guard_id) ||
+	    old_dependency->foundation || !old_dependency->prepare_absorb ||
+	    !old_dependency->abort_absorb || !old_dependency->commit_absorb ||
+	    !dependency || !foundation || coverage != &vpsadminos_coverage ||
+	    dependency->magic != VPSADMINOS_KLP_DEPENDENCY_MAGIC ||
+	    dependency->abi_version != VPSADMINOS_KLP_DEPENDENCY_STATE_VERSION ||
+	    !dependency->begin || !dependency->abort || !dependency->activate ||
+	    !dependency->deactivate || !dependency->complete_transition ||
+	    foundation->magic != VPSADMINOS_KLP_FOUNDATION_MAGIC ||
+	    foundation->abi_version != VPSADMINOS_KLP_FOUNDATION_STATE_VERSION ||
+	    !foundation->register_completion || !foundation->cancel_completion ||
+	    !foundation->complete_transition || !foundation->deactivate ||
+	    !foundation->target_claim || !foundation->target_release ||
+	    !foundation->target_generation || dependency->active ||
+	    dependency->absorbing || dependency->owner || dependency->foundation ||
+	    foundation->active || foundation->absorbing || foundation->owner ||
+	    foundation->dependency || foundation->artifact || coverage->active ||
+	    coverage->complete || coverage->failed || coverage->owner ||
+	    coverage->lifetime || vpsadminos_checkpoint_dependency ||
+	    vpsadminos_checkpoint_foundation || vpsadminos_checkpoint_artifact ||
+	    vpsadminos_checkpoint_old_dependency || vpsadminos_checkpoint_absorb ||
+	    vpsadminos_checkpoint_committed)
+		return -EINVAL;
+	ret = vpsadminos_prepare_identity(LIVEPATCH_ORIG_KERNEL_VERSION,
+					  "6.12.95.7",
+					  LIVEPATCH_ORIG_KERNEL_VERSION);
+	if (ret)
+		return ret;
+	ret = old_dependency->prepare_absorb(old_dependency, patch->mod,
+		&vpsadminos_v7_checkpoint_spec,
+		vpsadminos_v7_checkpoint_predecessors,
+		ARRAY_SIZE(vpsadminos_v7_checkpoint_predecessors), dependency,
+		&vpsadminos_checkpoint_absorb, &vpsadminos_checkpoint_artifact);
+	if (ret)
+		goto clear_identity;
+	dependency->foundation = foundation;
+	foundation->owner = patch->mod;
+	foundation->owner_id = vpsadminos_v7_checkpoint_spec.artifact_id;
+	foundation->dependency = dependency;
+	foundation->artifact = vpsadminos_checkpoint_artifact;
+	ret = foundation->register_completion(foundation, patch->mod,
+		&vpsadminos_v7_checkpoint_spec.artifact_id,
+		vpsadminos_v7_checkpoint_terminal, patch);
+	if (ret)
+		goto clear_contracts;
+	vpsadminos_checkpoint_old_dependency = old_dependency;
+	vpsadminos_checkpoint_dependency = dependency;
+	vpsadminos_checkpoint_foundation = foundation;
+	return 0;
+
+clear_contracts:
+	foundation->artifact = NULL;
+	foundation->dependency = NULL;
+	foundation->owner = NULL;
+	foundation->owner_id = VPSADMINOS_KLP_ID(0, 0);
+	dependency->foundation = NULL;
+	old_dependency->abort_absorb(vpsadminos_checkpoint_absorb);
+	vpsadminos_checkpoint_absorb = NULL;
+	vpsadminos_checkpoint_artifact = NULL;
+clear_identity:
+	vpsadminos_identity_prepared = false;
+	return ret;
+}
+
+void vpsadminos_v7_checkpoint_post_unpatch(struct klp_object *obj)
+{
+	struct vpsadminos_klp_dependency_state *dependency, *old_dependency;
+	struct vpsadminos_klp_foundation_state *foundation;
+	struct klp_patch *patch = vpsadminos_klp_object_patch(obj);
+
+	if (!patch)
+		return;
+	if (vpsadminos_checkpoint_committed) {
+		if (WARN_ON_ONCE(!vpsadminos_checkpoint_foundation ||
+				 !vpsadminos_checkpoint_foundation->complete_transition))
+			return;
+		/* The generated checkpoint keeps vmlinux last in callback order. */
+		foundation = vpsadminos_checkpoint_foundation;
+		foundation->complete_transition(foundation, patch);
+		return;
+	}
+	if (!vpsadminos_checkpoint_old_dependency ||
+	    !vpsadminos_checkpoint_dependency ||
+	    !vpsadminos_checkpoint_foundation ||
+	    !vpsadminos_checkpoint_absorb)
+		return;
+	old_dependency = vpsadminos_checkpoint_old_dependency;
+	dependency = vpsadminos_checkpoint_dependency;
+	foundation = vpsadminos_checkpoint_foundation;
+	foundation->cancel_completion(foundation, patch->mod);
+	foundation->artifact = NULL;
+	foundation->dependency = NULL;
+	foundation->owner = NULL;
+	foundation->owner_id = VPSADMINOS_KLP_ID(0, 0);
+	dependency->foundation = NULL;
+	old_dependency->abort_absorb(vpsadminos_checkpoint_absorb);
+	vpsadminos_checkpoint_absorb = NULL;
+	vpsadminos_checkpoint_artifact = NULL;
+	vpsadminos_checkpoint_foundation = NULL;
+	vpsadminos_checkpoint_dependency = NULL;
+	vpsadminos_checkpoint_old_dependency = NULL;
+	vpsadminos_identity_prepared = false;
+}
+#else
+int vpsadminos_v7_checkpoint_pre_patch(struct klp_object *obj)
+{
+	(void)obj;
+	return 0;
+}
+
+void vpsadminos_v7_checkpoint_post_unpatch(struct klp_object *obj)
+{
+	(void)obj;
+}
+#endif /* LIVEPATCH_IS_CHECKPOINT */
+#endif /* LIVEPATCH_IS_GENERATION_FINAL || LIVEPATCH_IS_CHECKPOINT */
