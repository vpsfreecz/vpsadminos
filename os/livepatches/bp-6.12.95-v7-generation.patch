+static bool vpsadminos_identity_prepared;
+
+static int vpsadminos_prepare_identity(const char *expected,
+				       const char *replacement,
+				       const char *restore)
+{
+	int ret = 0;
+
+	if (!expected || !replacement || !restore ||
+	    strscpy(vpsadminos_prepared_release, replacement,
+		    sizeof(vpsadminos_prepared_release)) < 0 ||
+	    strscpy(vpsadminos_previous_release, restore,
+		    sizeof(vpsadminos_previous_release)) < 0)
+		return -EINVAL;
+	down_read(&uts_sem);
+	if (strcmp(init_uts_ns.name.release, expected))
+		ret = -EINVAL;
+	up_read(&uts_sem);
+	if (!ret)
+		vpsadminos_identity_prepared = true;
+	return ret;
+}
+
+static void vpsadminos_publish_identity(void)
+{
+	if (WARN_ON_ONCE(!vpsadminos_identity_prepared))
+		return;
+	down_write(&uts_sem);
+	strscpy(init_uts_ns.name.release, vpsadminos_prepared_release,
+		sizeof(init_uts_ns.name.release));
+	up_write(&uts_sem);
+	uts_proc_notify(UTS_PROC_OSRELEASE);
+}
+
+static void vpsadminos_restore_identity(void)
+{
+	if (WARN_ON_ONCE(!vpsadminos_identity_prepared))
+		return;
+	down_write(&uts_sem);
+	strscpy(init_uts_ns.name.release, vpsadminos_previous_release,
+		sizeof(init_uts_ns.name.release));
+	up_write(&uts_sem);
+	uts_proc_notify(UTS_PROC_OSRELEASE);
+	vpsadminos_identity_prepared = false;
+}
