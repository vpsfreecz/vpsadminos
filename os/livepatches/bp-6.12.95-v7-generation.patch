+static struct vpsadminos_klp_dependency_state *vpsadminos_final_dependency;
+static struct vpsadminos_klp_foundation_state *vpsadminos_final_foundation;
+static struct vpsadminos_klp_artifact_token *vpsadminos_final_artifact;
+
+static bool vpsadminos_dependency_contract_valid(
+		struct vpsadminos_klp_dependency_state *dependency)
+{
+	return dependency &&
+	       dependency->magic == VPSADMINOS_KLP_DEPENDENCY_MAGIC &&
+	       dependency->abi_version == VPSADMINOS_KLP_DEPENDENCY_STATE_VERSION &&
+	       smp_load_acquire(&dependency->active) && !dependency->absorbing &&
+	       dependency->begin && dependency->acquire && dependency->abort &&
+	       dependency->activate && dependency->deactivate &&
+	       dependency->prepare_absorb && dependency->abort_absorb &&
+	       dependency->commit_absorb;
+}
+
+static bool vpsadminos_foundation_contract_valid(
+		struct vpsadminos_klp_foundation_state *foundation)
+{
+	struct vpsadminos_klp_id expected =
+		VPSADMINOS_KLP_ID(VPSADMINOS_KLP_V7_FOUNDATION_ID_HI,
+				  VPSADMINOS_KLP_V7_FOUNDATION_ID_LO);
+
+	return foundation && foundation->magic == VPSADMINOS_KLP_FOUNDATION_MAGIC &&
+	       foundation->abi_version == VPSADMINOS_KLP_FOUNDATION_STATE_VERSION &&
+	       smp_load_acquire(&foundation->active) && !foundation->absorbing &&
+	       vpsadminos_klp_id_equal(&foundation->owner_id, &expected) &&
+	       foundation->owner &&
+	       !strcmp(foundation->owner->name, "lp61295_foundation") &&
+	       foundation->register_completion && foundation->cancel_completion &&
+	       foundation->complete_transition && foundation->deactivate &&
+	       foundation->prepare_absorb && foundation->abort_absorb &&
+	       foundation->commit_absorb;
+}
+
+static void vpsadminos_v7_final_terminal(struct module *owner, bool enabled,
+						 void *data)
+{
+	struct vpsadminos_klp_coverage_state *coverage = data;
+
+	if (WARN_ON_ONCE(!owner || coverage != &vpsadminos_coverage ||
+			 !vpsadminos_final_dependency ||
+			 !vpsadminos_final_artifact))
+		return;
+	if (enabled) {
+		vpsadminos_final_dependency->activate(
+			vpsadminos_final_dependency, vpsadminos_final_artifact);
+		coverage->owner = owner;
+		coverage->lifetime = vpsadminos_final_artifact;
+		coverage->owner_token =
+			VPSADMINOS_KLP_ID(VPSADMINOS_KLP_V7_FINAL_ID_HI,
+					  VPSADMINOS_KLP_V7_FINAL_ID_LO);
+		coverage->final_token = coverage->owner_token;
+		WRITE_ONCE(coverage->completed_artifacts, BIT_ULL(0));
+		smp_store_release(&coverage->active, true);
+		smp_store_release(&coverage->complete, true);
+		WRITE_ONCE(vpsadminos_generation_active, true);
+		WRITE_ONCE(vpsadminos_generation_complete, true);
+		vpsadminos_publish_identity();
+		return;
+	}
+	vpsadminos_restore_identity();
+	WRITE_ONCE(vpsadminos_generation_complete, false);
+	WRITE_ONCE(vpsadminos_generation_active, false);
+	smp_store_release(&coverage->complete, false);
+	smp_store_release(&coverage->active, false);
+	coverage->owner = NULL;
+	coverage->lifetime = NULL;
+	vpsadminos_final_dependency->deactivate(vpsadminos_final_dependency,
+						vpsadminos_final_artifact);
+	vpsadminos_final_artifact = NULL;
+	vpsadminos_final_dependency = NULL;
+	vpsadminos_final_foundation = NULL;
+}
+
+static int __maybe_unused
+vpsadminos_v7_final_pre_patch(struct klp_object *obj)
+{
+	struct vpsadminos_klp_dependency_token *dependency_token;
+	struct vpsadminos_klp_dependency_state *dependency;
+	struct vpsadminos_klp_foundation_state *foundation;
+	struct klp_patch *patch = vpsadminos_klp_object_patch(obj);
+	struct klp_state *record;
+	int ret;
+
+	if (!patch || patch != klp_transition_patch ||
+	    klp_get_prev_state(VPSADMINOS_KLP_COVERAGE_STATE_ID))
+		return -EINVAL;
+	record = klp_get_prev_state(VPSADMINOS_KLP_DEPENDENCY_STATE_ID);
+	dependency = record ? record->data : NULL;
+	record = klp_get_prev_state(VPSADMINOS_KLP_FOUNDATION_STATE_ID);
+	foundation = record ? record->data : NULL;
+	if (!vpsadminos_dependency_contract_valid(dependency) ||
+	    !vpsadminos_foundation_contract_valid(foundation) ||
+	    foundation->dependency != dependency ||
+	    dependency->foundation != foundation)
+		return -EINVAL;
+	ret = dependency->begin(dependency, patch->mod, &vpsadminos_v7_final_spec,
+				&vpsadminos_final_artifact);
+	if (ret)
+		return ret;
+	ret = dependency->acquire(dependency, vpsadminos_final_artifact,
+				  &vpsadminos_v7_anchor_spec, &dependency_token);
+	if (ret)
+		goto abort;
+	ret = dependency->acquire(dependency, vpsadminos_final_artifact,
+				  &vpsadminos_v7_guard_spec, &dependency_token);
+	if (ret)
+		goto abort;
+	ret = dependency->acquire(dependency, vpsadminos_final_artifact,
+				  &vpsadminos_v7_foundation_spec,
+				  &dependency_token);
+	if (ret)
+		goto abort;
+	ret = vpsadminos_prepare_identity("6.12.95.6", "6.12.95.7",
+					  "6.12.95.6");
+	if (ret)
+		goto abort;
+	ret = foundation->register_completion(
+		foundation, patch->mod, &vpsadminos_v7_final_spec.artifact_id,
+		vpsadminos_v7_final_terminal, &vpsadminos_coverage);
+	if (ret)
+		goto abort_identity;
+	vpsadminos_final_dependency = dependency;
+	vpsadminos_final_foundation = foundation;
+	return 0;
+
+abort_identity:
+	vpsadminos_identity_prepared = false;
+abort:
+	dependency->abort(dependency, vpsadminos_final_artifact);
+	vpsadminos_final_artifact = NULL;
+	return ret;
+}
+
+static void __maybe_unused
+vpsadminos_v7_final_post_patch(struct klp_object *obj)
+{
+	/* Generation and identity publication are terminal-completion work. */
+	(void)obj;
+}
+
+static void __maybe_unused
+vpsadminos_v7_final_post_unpatch(struct klp_object *obj)
+{
+	struct klp_patch *patch = vpsadminos_klp_object_patch(obj);
+
+	if (!patch || vpsadminos_coverage.active || !vpsadminos_final_foundation)
+		return;
+	vpsadminos_final_foundation->cancel_completion(
+		vpsadminos_final_foundation, patch->mod);
+	vpsadminos_final_dependency->abort(vpsadminos_final_dependency,
+					  vpsadminos_final_artifact);
+	vpsadminos_final_artifact = NULL;
+	vpsadminos_final_dependency = NULL;
+	vpsadminos_final_foundation = NULL;
+	vpsadminos_identity_prepared = false;
+}
+
