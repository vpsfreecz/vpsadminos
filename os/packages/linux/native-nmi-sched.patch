diff --git a/kernel/livepatch/transition-state-vpsadminos.h b/kernel/livepatch/transition-state-vpsadminos.h
new file mode 100644
index 0000000000000..e61728f910a93
--- /dev/null
+++ b/kernel/livepatch/transition-state-vpsadminos.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LIVEPATCH_VPSADMINOS_TRANSITION_STATE_H
+#define _LIVEPATCH_VPSADMINOS_TRANSITION_STATE_H
+
+#include <linux/cgroup.h>
+#include <linux/pid_namespace.h>
+
+#define VPSADMINOS_KLP_STATE_BATCH_SIZE 64
+
+static void vpsadminos_klp_set_task_state(struct task_struct *task, int state)
+{
+	if (state == KLP_TRANSITION_IDLE)
+		WARN_ON_ONCE(test_tsk_thread_flag(task, TIF_PATCH_PENDING));
+	else
+		WARN_ON_ONCE(task->patch_state != KLP_TRANSITION_IDLE);
+	WRITE_ONCE(task->patch_state, state);
+}
+
+/*
+ * Initialize/reset the live task set without a population-sized spinlocked
+ * walk. The caller preserves the normal function-selection barriers and holds
+ * klp_mutex; no transition task flags are changed here.
+ */
+static void vpsadminos_klp_set_task_states(int state)
+{
+	struct task_struct *task;
+	unsigned int cpu;
+#ifdef CONFIG_CGROUPS
+	struct pid *pid;
+	unsigned int scanned;
+	int next_pid = 1;
+	bool done = false;
+#else
+	struct task_struct *g;
+#endif
+
+	lockdep_assert_held(&klp_mutex);
+
+	/* Follow cgroup_attach_lock() ordering, without a cgroup-internal API. */
+	cpus_read_lock();
+#ifdef CONFIG_CGROUPS
+	percpu_down_write(&cgroup_threadgroup_rwsem);
+	/*
+	 * This excludes fork publication/state inheritance and exec PID swaps.
+	 * Only removals can change the live PID set. Consequently every task
+	 * still linked at the end of the walk has been initialized, just as for
+	 * an atomic tasklist walk at that point. Tasks already unlinked are not
+	 * added to the transition, matching the original tasklist semantics.
+	 * Later children inherit the initialized state when exclusion ends.
+	 *
+	 * Never retain a task-list cursor across RCU sections: even a referenced
+	 * task can be unlinked and its old successor can subsequently be freed.
+	 * A monotonically increasing global PID cursor survives those removals.
+	 */
+	while (!done) {
+		rcu_read_lock();
+		for (scanned = 0; scanned < VPSADMINOS_KLP_STATE_BATCH_SIZE;
+		     scanned++) {
+			pid = find_ge_pid(next_pid, &init_pid_ns);
+			if (!pid) {
+				done = true;
+				break;
+			}
+			next_pid = pid_nr(pid) + 1;
+			task = pid_task(pid, PIDTYPE_PID);
+			/* Count PID objects even if no task is attached yet. */
+			if (task)
+				vpsadminos_klp_set_task_state(task, state);
+		}
+		rcu_read_unlock();
+		cond_resched();
+	}
+	/*
+	 * __unhash_process() detaches the PID before removing the task-list
+	 * nodes. Drain any such in-flight writer so this is also a completed
+	 * task-list removal. The live set at this point is fully initialized;
+	 * no population-sized work is performed while holding tasklist_lock.
+	 */
+	read_lock(&tasklist_lock);
+	read_unlock(&tasklist_lock);
+#else
+	/* Without fork exclusion retain the original atomic walk. */
+	read_lock(&tasklist_lock);
+	for_each_process_thread(g, task)
+		vpsadminos_klp_set_task_state(task, state);
+	read_unlock(&tasklist_lock);
+#endif
+
+	for_each_possible_cpu(cpu)
+		vpsadminos_klp_set_task_state(idle_task(cpu), state);
+
+#ifdef CONFIG_CGROUPS
+	percpu_up_write(&cgroup_threadgroup_rwsem);
+#endif
+	cpus_read_unlock();
+}
+
+#endif /* _LIVEPATCH_VPSADMINOS_TRANSITION_STATE_H */
